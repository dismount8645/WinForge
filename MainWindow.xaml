<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ViVeToolApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ViVeToolApp"
    xmlns:models="using:ViVeToolApp.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ViVeTool Feature Enabler">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!-- B-02: CardBorderStyle extracted for maintainability (Window.Resources not supported on WinUI3 Window, using Grid.Resources) -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Top InfoBar -->
            <RowDefinition Height="*"/>    <!-- Row 1: Main Content -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Log Expander -->
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <!-- L-01/L-04: Responsive breakpoints per MS guidelines (320px safe) and audit 720px collapse.
                     Compact 0-640 collapsed, Medium 641-719 collapsed, Narrow 720-919 expanded, Wide 920+ expanded.
                     No gap; collapse at <720 ensures 320px reflow does not clip. -->
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightPanelScroller.Visibility" Value="Collapsed"/>
                        <Setter Target="BottomRightPanel.Visibility" Value="Visible"/>
                        <Setter Target="MainContentGrid.Margin" Value="8,8,8,8"/>
                        <!-- L-01: Reduce non-essential font/margin at 320px to prevent clipping -->
                        <Setter Target="SearchBox.FontSize" Value="12"/>
                        <Setter Target="SummaryText.FontSize" Value="11"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightPanelScroller.Visibility" Value="Collapsed"/>
                        <Setter Target="BottomRightPanel.Visibility" Value="Visible"/>
                        <Setter Target="MainContentGrid.Margin" Value="8,8,8,8"/>
                        <Setter Target="SearchBox.FontSize" Value="12"/>
                        <Setter Target="SummaryText.FontSize" Value="11"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightPanelScroller.Visibility" Value="Visible"/>
                        <Setter Target="BottomRightPanel.Visibility" Value="Collapsed"/>
                        <Setter Target="MainContentGrid.Margin" Value="10,8,10,8"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="920"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightPanelScroller.Visibility" Value="Visible"/>
                        <Setter Target="BottomRightPanel.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="WindowHeightStates">
                <VisualState x:Name="TallState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="700"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="CompactHeightState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LogExpander.MaxHeight" Value="120"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- A-01: Level1 heading for UIA outline (hidden visually, exposed to narrator) -->
        <TextBlock Text="ViVeTool Feature Enabler"
                   AutomationProperties.HeadingLevel="Level1"
                   Opacity="0" IsHitTestVisible="False" Height="0"
                   AutomationProperties.Name="ViVeTool Feature Enabler"/>

        <!-- ═══════════════════════════════════════════════
             ROW 0: TOP NOTIFICATION INFOBAR
             ═══════════════════════════════════════════════ -->
        <InfoBar x:Name="MainInfoBar" Grid.Row="0"
                 IsOpen="False" Margin="12,8,12,0"
                 AutomationProperties.Name="Application status"
                 AutomationProperties.LiveSetting="Polite"/>

        <!-- ═══════════════════════════════════════════════
             ROW 1: MAIN CONTENT AREA (Left List + Right Panel)
             ═══════════════════════════════════════════════ -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── LEFT COLUMN: Feature Catalog ── -->
            <Border x:Name="CatalogContainer" Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Translation="0,0,16"
                    Margin="0">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <Grid>
                    <Grid.Resources>
                        <ScalarTransition x:Key="CatalogScalarTransition" Duration="0:0:0.2"/>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filter Bar -->
                        <RowDefinition Height="Auto"/> <!-- Column Header -->
                        <RowDefinition Height="*"/>    <!-- ListView + Overlay -->
                    </Grid.RowDefinitions>

                <!-- Search + Filter Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="0"
                                     PlaceholderText="Search features or IDs..."
                                     QueryIcon="Find"
                                     AccessKey="S"
                                     AutomationProperties.Name="Search features or IDs"
                                     ToolTipService.ToolTip="Search (Ctrl+F)"
                                     TextChanged="SearchBox_TextChanged">
                        <AutoSuggestBox.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F" Modifiers="Control"/>
                        </AutoSuggestBox.KeyboardAccelerators>
                    </AutoSuggestBox>
                    <ComboBox x:Name="GroupFilter" Grid.Column="2"
                               Header="Group"
                               PlaceholderText="All groups"
                               AutomationProperties.Name="Filter by group"
                               SelectionChanged="GroupFilter_SelectionChanged"
                               HorizontalAlignment="Stretch"
                               MinWidth="120"
                               MaxWidth="160"/>
                    <Button x:Name="RefreshBtn" Grid.Column="4"
                             Style="{StaticResource AccentButtonStyle}"
                             Click="RefreshBtn_Click"
                             MinHeight="32"
                             MinWidth="36"
                             Padding="8,4"
                             FocusVisualMargin="-3"
                             AccessKey="R"
                             AutomationProperties.Name="Refresh feature catalog"
                             ToolTipService.ToolTip="Re-fetch latest codes from pureinfotech.com (Ctrl+R)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="R" Modifiers="Control"/>
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE72C;" FontSize="12" FontFamily="Segoe Fluent Icons"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Column Header Border (Aligned with ListView columns) -->
                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="8,8,0,0"
                        Padding="12,6,16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="130" MinWidth="120"/>
                            <ColumnDefinition Width="110" MinWidth="100"/>
                            <ColumnDefinition Width="*" MinWidth="140"/>
                            <ColumnDefinition Width="190" MinWidth="170"/>
                            <ColumnDefinition Width="96" MinWidth="84"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0"
                                  AutomationProperties.Name="Select all visible features"
                                  Click="SelectAllCheckBox_Click"
                                  VerticalAlignment="Center"
                                  MinWidth="24"
                                  MinHeight="24"/>
                        <TextBlock Grid.Column="1" Text="Group"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="Build"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="Feature Description"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="ID(s)"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="5" Text="Status"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.Name="Execution status"/>
                    </Grid>
                </Border>

                <!-- Feature ListView -->
                <ListView x:Name="FeatureListView" Grid.Row="2"
                          AutomationProperties.Name="Feature catalog"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="FeatureListView_ItemClick"
                          ShowsScrollingPlaceholders="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="0,0,8,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,4,16,4"/>
                            <Setter Property="MinHeight" Value="44"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FeatureItem">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="130" MinWidth="120"/>
                                    <ColumnDefinition Width="110" MinWidth="100"/>
                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                    <ColumnDefinition Width="190" MinWidth="170"/>
                                    <ColumnDefinition Width="96" MinWidth="84"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          IsTabStop="False"
                                          AutomationProperties.Name="{x:Bind Description}"
                                          Click="FeatureCheckBox_Click"/>
                                <TextBlock Grid.Column="1" x:Phase="1" Text="{x:Bind Group, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            MaxLines="2"
                                            LineHeight="14"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            ToolTipService.ToolTip="{x:Bind Group, Mode=OneWay}"
                                            AutomationProperties.HelpText="{x:Bind Group, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Column="2" x:Phase="2" Text="{x:Bind BuildLabel, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           ToolTipService.ToolTip="{x:Bind BuildLabel, Mode=OneWay}"
                                           AutomationProperties.HelpText="{x:Bind BuildLabel, Mode=OneWay}"
                                           IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Column="3" x:Phase="2" Text="{x:Bind Description, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            MaxLines="2"
                                            LineHeight="16"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}"
                                            AutomationProperties.HelpText="{x:Bind Description, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"/>
                                <TextBlock Grid.Column="4" x:Phase="3" Text="{x:Bind IDsDisplay, Mode=OneWay}"
                                              Style="{StaticResource CaptionTextBlockStyle}"
                                              FontFamily="Cascadia Code,Consolas"
                                              VerticalAlignment="Center"
                                              TextWrapping="Wrap"
                                              MaxLines="3"
                                              LineHeight="13"
                                              TextTrimming="CharacterEllipsis"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              ToolTipService.ToolTip="{x:Bind IDsDisplay, Mode=OneWay}"
                                              AutomationProperties.HelpText="{x:Bind IDsDisplay, Mode=OneWay}"
                                              IsTextSelectionEnabled="True"/>
                                <Grid Grid.Column="5" VerticalAlignment="Center"
                                      ToolTipService.ToolTip="{x:Bind StatusToolTip, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind StatusAccessibilityName, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{x:Bind StatusBrush, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw"
                                                  ToolTipService.ToolTip="{x:Bind StatusToolTip, Mode=OneWay}"/>
                                        <TextBlock x:Phase="3" Text="{x:Bind StatusLabel, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind StatusToolTip, Mode=OneWay}"
                                                   AutomationProperties.HelpText="{x:Bind StatusToolTip, Mode=OneWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty Filter Overlay (D11) -->
                <Border x:Name="EmptyFilterOverlay" Grid.Row="2"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        CornerRadius="0,0,8,8" Visibility="Collapsed"
                        AutomationProperties.Name="No features match filter"
                        AutomationProperties.LiveSetting="Polite">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15"/>
                    </Border.OpacityTransition>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE71C;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No features match" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Try a different search or group filter." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Loading Overlay -->
                <Border x:Name="LoadingOverlay" Grid.Row="2"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        CornerRadius="0,0,8,8" Visibility="Collapsed"
                        AutomationProperties.Name="Loading feature catalog"
                        AutomationProperties.LiveSetting="Polite">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15"/>
                    </Border.OpacityTransition>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                        <ProgressRing IsActive="True" Width="44" Height="44"
                                      AutomationProperties.Name="Loading"/>
                        <TextBlock Text="Fetching latest codes from pureinfotech.com..."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                </Grid>
            </Border>

            <!-- ── RIGHT COLUMN: Control Panel ── -->
            <ScrollViewer x:Name="RightPanelScroller" Grid.Column="2" Grid.Row="0"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled"
                           Padding="0,0,12,0">
                <StackPanel Spacing="10">

                    <!-- Card 1: ViVeTool Engine Status & Actions -->
                    <Border Style="{StaticResource CardBorderStyle}" Translation="0,0,8">
                        <Border.Shadow>
                            <ThemeShadow/>
                        </Border.Shadow>
                        <StackPanel Spacing="8">
                            <TextBlock Text="ViVeTool Engine"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>

                            <!-- Inline Status InfoBar -->
                            <InfoBar x:Name="ViveToolStatus"
                                     IsOpen="True" IsClosable="False"
                                     Title="ViVeTool" Message="Checking..."
                                     Severity="Informational" Margin="0,2,0,2"
                                     ToolTipService.ToolTip="{x:Bind ViewModel.ViveExe, Mode=OneWay}"
                                     AutomationProperties.Name="ViVeTool status"
                                     AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="ViveExePathText"
                                       Text="{x:Bind ViewModel.ViveExe, Mode=OneWay}"
                                       IsTextSelectionEnabled="True"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="Cascadia Code,Consolas"
                                       FontSize="11"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.ViveExe, Mode=OneWay}"
                                       AutomationProperties.Name="ViVeTool executable path"/>

                            <!-- D10: Download full-width when not found, Copy path -->
                            <Button x:Name="DownloadViveToolBtn"
                                     HorizontalAlignment="Stretch"
                                     MinHeight="32"
                                     MinWidth="36"
                                     Padding="8,4"
                                     FocusVisualMargin="-3"
                                     Click="DownloadViveToolBtn_Click"
                                     ToolTipService.ToolTip="Download latest ViVeTool from GitHub"
                                     AutomationProperties.Name="Download ViVeTool">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                                    <TextBlock Text="Download ViVeTool"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopyVivePathBtn"
                                     HorizontalAlignment="Stretch"
                                     MinHeight="32"
                                     MinWidth="36"
                                     Padding="8,4"
                                     FocusVisualMargin="-3"
                                     Click="CopyVivePathBtn_Click"
                                     Visibility="Collapsed"
                                     ToolTipService.ToolTip="Copy vivetool.exe path to clipboard"
                                     AutomationProperties.Name="Copy vivetool path">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                                    <TextBlock Text="Copy path" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>

                            <!-- Action Buttons -->
                            <StackPanel Spacing="8" Margin="0,4,0,0">
                                <Button x:Name="EnableBtn"
                                         Style="{StaticResource AccentButtonStyle}"
                                         HorizontalAlignment="Stretch"
                                         MinHeight="36"
                                         FocusVisualMargin="-3"
                                         AccessKey="E"
                                         AutomationProperties.Name="Enable selected features"
                                         Click="EnableBtn_Click"
                                         ToolTipService.ToolTip="Enable checked feature IDs via vivetool /enable (Alt+E)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                        <TextBlock x:Name="EnableBtnText" Text="Enable Selected"/>
                                    </StackPanel>
                                </Button>
                                <!-- Separator (D06) -->
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>
                                <Button x:Name="DisableBtn"
                                         HorizontalAlignment="Stretch"
                                         MinHeight="36"
                                         FocusVisualMargin="-3"
                                         AutomationProperties.Name="Disable selected features"
                                         Click="DisableBtn_Click"
                                         ToolTipService.ToolTip="Disable checked feature IDs — rollback"
                                         Background="{ThemeResource SystemFillColorCriticalBrush}"
                                         Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                         BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                        <TextBlock x:Name="DisableBtnText" Text="Disable Selected"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CancelBtn"
                                         HorizontalAlignment="Stretch"
                                         MinHeight="32"
                                         MinWidth="36"
                                         Padding="8,4"
                                         FocusVisualMargin="-3"
                                         AutomationProperties.Name="Cancel batch"
                                         Click="CancelBtn_Click"
                                         Visibility="Collapsed"
                                         ToolTipService.ToolTip="Cancel running batch">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                                        <TextBlock Text="Cancel"/>
                                    </StackPanel>
                                </Button>
                                <InfoBar x:Name="PreviewInfoBar"
                                         Severity="Informational"
                                         Title="Preview mode"
                                         Message="No system changes will be made. Turn off Preview to apply."
                                         IsOpen="False" IsClosable="False" Margin="0,2,0,0"
                                         AutomationProperties.Name="Preview mode"
                                         AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Selection & Batch Management -->
                    <Border Style="{StaticResource CardBorderStyle}" Translation="0,0,8">
                        <Border.Shadow>
                            <ThemeShadow/>
                        </Border.Shadow>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Selection Overview"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock x:Name="SummaryText" Text="Loading..."
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        FontSize="13"
                                        TextWrapping="WrapWholeWords"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                                        IsTextSelectionEnabled="True"/>
                            <ProgressBar x:Name="SelectionProgress" Value="0" Maximum="100"
                                         Height="6"
                                         ShowError="{x:Bind ViewModel.HasError, Mode=OneWay}" ShowPaused="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                                         AutomationProperties.Name="Selection progress"/>
                            <TextBlock x:Name="SelectionProgressLabel" Text="0% selected"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="LastUpdatedText" Text=""
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}"
                                        IsTextSelectionEnabled="True"/>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>
                            <TextBlock Text="Status Breakdown"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.HeadingLevel="Level3"/>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Name="SuccessBreakdownText" Text="Success: 0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Name="SkippedBreakdownText" Text="Skipped: 0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE783;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Name="ErrorBreakdownText" Text="Error: 0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource SystemFillColorAttentionBrush}" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Name="PendingBreakdownText" Text="Pending: 0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#x2014;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Name="NotRunBreakdownText" Text="Not run: 0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="StatusBreakdownDetail" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.StatusBreakdownDetail, Mode=OneWay}" IsTextSelectionEnabled="True"/>
                            </StackPanel>

                            <!-- Quick Select 2x2 Grid -->
                            <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button x:Name="SelectAllBtn" Grid.Row="0" Grid.Column="0" Content="Select All"
                                        HorizontalAlignment="Stretch" Click="SelectAllBtn_Click" FontSize="11" MinHeight="32" MinWidth="36" Padding="8,4" FocusVisualMargin="-3" AutomationProperties.Name="Select all features"/>
                                <Button x:Name="ClearAllBtn" Grid.Row="0" Grid.Column="1" Content="Clear All"
                                        HorizontalAlignment="Stretch" Click="ClearAllBtn_Click" FontSize="11" MinHeight="32" MinWidth="36" Padding="8,4" FocusVisualMargin="-3" AutomationProperties.Name="Clear all selections"/>
                                <Button x:Name="SelectFilteredBtn" Grid.Row="1" Grid.Column="0" Content="Select Filtered"
                                        HorizontalAlignment="Stretch" Click="SelectGroupBtn_Click" FontSize="11" MinHeight="32" MinWidth="36" Padding="8,4" FocusVisualMargin="-3" AutomationProperties.Name="Select filtered group"/>
                                <Button x:Name="ClearFilteredBtn" Grid.Row="1" Grid.Column="1" Content="Clear Filtered"
                                        HorizontalAlignment="Stretch" Click="ClearGroupBtn_Click" FontSize="11" MinHeight="32" MinWidth="36" Padding="8,4" FocusVisualMargin="-3" AutomationProperties.Name="Clear filtered group"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Execution Options -->
                    <Border Style="{StaticResource CardBorderStyle}" Translation="0,0,8">
                        <Border.Shadow>
                            <ThemeShadow/>
                        </Border.Shadow>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Execution Options"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <ToggleSwitch x:Name="WhatIfToggle" Header="Preview only — no changes"
                                          IsOn="False"
                                          Toggled="WhatIfToggle_Toggled"
                                          ToolTipService.ToolTip="When on, commands are logged but no system changes are made."/>
                            <StackPanel Spacing="2">
                                <ToggleSwitch x:Name="RestartExplorerToggle" Header="Restart Explorer"
                                              IsOn="False"
                                              ToolTipService.ToolTip="If on, Explorer will be gracefully restarted after changes. Open folders will close."/>
                                <TextBlock Text="Closes open folders after applying changes."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,-4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- L-01 Bottom panel for Compact/Medium: duplicate controls collapsed by default, shown when RightPanelScroller collapsed -->
            <ScrollViewer x:Name="BottomRightPanel" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled"
                           Visibility="Collapsed"
                           Margin="0,8,0,0"
                           Padding="0,0,12,0">
                <StackPanel Spacing="10">
                    <Border Style="{StaticResource CardBorderStyle}" Translation="0,0,8">
                        <Border.Shadow>
                            <ThemeShadow/>
                        </Border.Shadow>
                        <StackPanel Spacing="6">
                            <TextBlock Text="ViVeTool Engine" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Text="Use expanded view (≥720px) for full controls." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Translation="0,0,8">
                        <Border.Shadow>
                            <ThemeShadow/>
                        </Border.Shadow>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Selection Overview" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Text="Selection details available in wide layout." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════════════════
             ROW 2: LOG EXPANDER (Single border, header toolbar)
             ═══════════════════════════════════════════════ -->
        <Expander x:Name="LogExpander" Grid.Row="2"
                   Margin="12,0,12,8"
                   IsExpanded="True"
                   HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Stretch"
                   Padding="0">
            <Expander.Header>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE756;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Output Log" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                    </StackPanel>
                    <!-- Progress Bar visible in Header even when collapsed -->
                    <ProgressBar x:Name="RunProgress" Grid.Column="1"
                                 Margin="16,0,16,0" VerticalAlignment="Center"
                                 Height="6" Value="0" Maximum="100"
                                 ShowError="{x:Bind ViewModel.HasError, Mode=OneWay}" ShowPaused="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                                 AutomationProperties.Name="Execution progress"/>
                </Grid>
            </Expander.Header>
            <Grid MinHeight="80" MaxHeight="200" Height="Auto" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="LogScroller" Grid.Row="0"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled"
                               Padding="12,8">
                    <TextBlock x:Name="LogText"
                               AutomationProperties.Name="Output log"
                               FontFamily="Cascadia Code,Consolas"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"/>
                </ScrollViewer>
                <Grid Grid.Row="1" Padding="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Button x:Name="ClearLogBtn" Content="Clear"
                            Click="ClearLogBtn_Click"
                            MinHeight="32"
                            MinWidth="72"
                            Padding="8,4"
                            FontSize="12"
                            FocusVisualMargin="-3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Clear output log"/>
                </Grid>
            </Grid>
        </Expander>

        <TeachingTip x:Name="FirstRunTip" Target="{x:Bind FeatureListView}" Title="Check features to enable" Subtitle="Use Status column to see per-feature results. Filter by Error to retry." IsLightDismissEnabled="True" CloseButtonContent="Got it" />

    </Grid>
</Window>






